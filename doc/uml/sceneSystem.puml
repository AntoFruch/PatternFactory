@startuml sceneSystem

namespace SceneSystem {

    class Scene{
        - mObjects : vector<GameObject>

        + Scene(vector<GameObject>)
        + Start() : void
        + Update(elapsedTime : sf::Time) : void
        + instantiate(vector<GameObject>) : void
    }

    class SceneManager {
        - scene : Scene
        - builder : SceneBuilder
        - requestedScene : string
        - requestedGOs : vector<GameObject>

        + SceneManager(builder: SceneBuilder)
        + requestLoading(path: string) : void
        - applyLoadingRequest() : void
    }

    note left of Scene::Start
        Template method:
            1 - enable all mObjects element
            2 - start all mObjects element
    endnote

    abstract class SceneBuilder{
        + prefabRegistry : map<string, vector<GameObject>>

        + {abstract} buildScene(filepath: string): void
        + {abstract} buildPrefab(filepath: string) : vector<GameObject>
    }
    note right of SceneBuilder::prefabRegistry
        prefabRegistry stores prototypes
        of prefab that were instantiated
        before, so there is no need to
        parse the prefab file again.
    endnote

    class XMLSceneBuilder{
        - buildGameObject(xml_node) : vector<GameObject>
    }

    XMLSceneBuilder --|> SceneBuilder

    class GameObject{
        - components : std::vector<unique_ptr<Component>>
        - active : bool
        - waitingDestruction : bool
        + transform : Transform

        + GameObject(args)
        + start() void
        + update(elapsedTime: sf:Time) : void
        + addComponent(unique_ptr<Component>) : void
        + getComponent<T>() : T*
        + setActive(bool) : void
        + destroySelf();
        + clone() : vector<GameObject>
    }

    class Transform {
        - position : sf::Vector2f
        - rotation : sf::Angle
        - scale : sf::Vector2f
        - children : std::vector<Transform*>

        + Transform(pos, rot, sca, gameObject)
        + addChild(child: Transform*) : void

        + getLocalPosition() : sf::Vector2f
        + getLocalRotation() : sf::Angle
        + getLocalScale() : sf::Vector2f

        + getWorldPosition() : sf::Vector2f
        + getWorldRotation() : sf::Angle
        + getWorldScale() : sf::Vector2f

        + setLocalPosition() : sf::Vector2f
        + setLocalRotation() : void
        + setLocalScale() : void

        + move() : void
        + rotate() : void
        + rescale() : void
    }

    SceneBuilder "creates" --> Scene
    SceneManager --* Scene
    SceneManager --* SceneBuilder

    GameObject --* Transform
    Transform --o Transform

    Scene --* GameObject
}

@enduml