@startuml inputSystem
namespace InputSystem{

    class InputManager{
        - actions : map<string, unique_ptr<InputAction>
        - pressed_key : set<Keyboard::Key>

        + InputManager(configFile: string)
        + findAction(name: string) : InputAction*
        + beginFrame() : void
        + processEvents() : void
        - loadActions() : void
    }

    class InputAction{
        - label : string
        - value : variant<bool, Vector2f>
        - pressedThisFrame : bool
        - bindings :

        + InputAction(label: string, bindings: );
        + resetFrameState() : void
        + processEvents() : void
        + wasPerformedThisFrame() : bool
        + ReadValue<T>() : T
    }

    note bottom of InputAction
            FIXME: add mouse input, maybe
    end note

    InputManager --* InputAction
}

@enduml