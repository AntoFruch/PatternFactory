@startuml renderSystem

namespace RenderSystem {
    class RenderManager{
        - mRenderers : std::vector<Renderer*>
        - mainCamera : Camera*
        - window : RenderWindow*
        - gui : Gui*

        + RenderManager(RenderWindow*, Gui*)
        + registerRenderer(Renderer*) : void
        + unregisterRenderer(Renderer*) : void
        + renderAll() : void
        + setMainCamera(Camera*) : void
        + unsetMainCamera(Camera*) : void
        + handleResize(size: sf::Vector2u) : void
    }

    class Renderer{
        - mShape : sf::RectangleShape
        - texture : sf::Texture
        - spriteSize : sf::Vector2u
        - cutRect : sf::IntRect
        - layer : int
        - sortOffsetY : float

        + Renderer(args)
        + render(win: RenderWindow) : void
        + setCutRectPos(x, y: unsigned int)

        - {static} s_registered: bool
    }

    RenderManager "keeps references"--o Renderer
}
@enduml