@startuml classDiagram
!include renderSystem.puml
!include sceneSystem.puml
!include inputSystem.puml
!include components.puml
!include fileParsing.puml
!include animationSystem.puml
!include collisionsSystem.puml

skinparam linetype ortho

class Game {
   + Game()
   + run() : void
   - processEvents() : void
   - update() : void
   - render() : void

   - scene : std:unique_ptr<Scene>
   - mWindow : RenderWindow
}

class GameContext {
    - inputManager : InputManager
    - renderer : Renderer
    - collisionsManager: CollisionsManager
    - resourceManager: ResourceManager
    - animationTreeManager : AnimationTreeManager
    - mSceneManager : SceneManager
    - parser : Parser

    - window : RenderWindow*

    + instance() : GameContext&
    + getters1()
    + getters2()
    + getters3()
    + ...()
}

note left of GameContext::mParser
    We instantiate a ParserDispatcher
    here, but by putting another
    Parser derived class we can
    lock the parsing behaviour.
endnote

Game *-- GameContext

GameContext *-- fileParsing.Parser
GameContext *-- RenderSystem.RenderManager
GameContext *-- RenderSystem.ResourceManager
GameContext *-- InputSystem.InputManager
GameContext *-- SceneSystem.SceneManager
GameContext *-- AnimationSystem.AnimationTreeManager
GameContext *-- CollisionsSystem.CollisionsManager
Parser "creates"--> SceneSystem.Scene

GameObject *-- ComponentsSystem.ComponentBase
Renderer --|> ComponentsSystem.ComponentBase
Animator --|> ComponentsSystem.ComponentBase
Collider --|> ComponentsSystem.ComponentBase

@enduml